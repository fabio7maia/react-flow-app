{
	"name": "react-flow-app",
	"version": "3.0.0-alpha.0",
	"description": "Event-based navigation for React: flows declared as data, typed end to end, with a diagram, generated tests and analytics out of the box.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			},
			"require": {
				"types": "./dist/react.d.cts",
				"default": "./dist/react.cjs"
			}
		},
		"./analytics": {
			"import": {
				"types": "./dist/analytics.d.ts",
				"default": "./dist/analytics.js"
			},
			"require": {
				"types": "./dist/analytics.d.cts",
				"default": "./dist/analytics.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			},
			"require": {
				"types": "./dist/testing.d.cts",
				"default": "./dist/testing.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"bin": {
		"react-flow-app": "./dist/cli.js"
	},
	"files": [
		"dist/"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:types": "tsc -p tsconfig.json",
		"completions": "node scripts/completions.mjs",
		"bench": "node scripts/bench.mjs",
		"e2e": "node scripts/e2e.mjs",
		"demo": "node scripts/demo.mjs",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"check:flows": "node scripts/check-example.mjs",
		"smoke": "node scripts/smoke.mjs",
		"lint": "eslint src test examples stories .storybook scripts e2e eslint.config.js tsup.config.ts vitest.config.ts && cspell --no-progress \"src/**/*.{ts,tsx}\"",
		"format": "prettier --write src test examples stories .storybook scripts e2e .github",
		"format:check": "prettier --check src test examples stories .storybook scripts e2e .github",
		"changeset": "changeset",
		"release": "yarn build && changeset publish",
		"prepare": "husky"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"jiti": "^2.4.2"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.5",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/js": "^9.30.1",
		"@storybook/addon-essentials": "^8.6.18",
		"@storybook/blocks": "^8.6.18",
		"@storybook/react": "^8.6.18",
		"@storybook/react-vite": "^8.6.18",
		"@types/node": "^22.15.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.4",
		"cspell": "^8.19.4",
		"esbuild": "^0.25.5",
		"eslint": "^9.30.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"lint-staged": "^15.5.2",
		"playwright-core": "1.64.1",
		"prettier": "^3.6.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"storybook": "^8.6.18",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.1",
		"vite": "^6.4.5",
		"vitest": "^3.2.4"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/fabio7maia/react-flow-app"
	},
	"author": {
		"email": "fabio7maia@gmail.com",
		"name": "Fábio Maia"
	},
	"keywords": [
		"react",
		"flow",
		"navigation",
		"wizard",
		"multistep",
		"workflow",
		"state machine",
		"analytics",
		"typescript"
	]
}
