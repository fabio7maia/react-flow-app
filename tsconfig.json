{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"types": ["node"],
		"paths": {
			"react-flow-app": ["./src/index.ts"],
			"react-flow-app/react": ["./src/react/index.tsx"],
			"react-flow-app/*": ["./src/*/index.ts"]
		}
	},
	"include": [
		"src/index.ts",
		"src/core",
		"src/react",
		"src/analytics",
		"src/testing",
		"src/cli",
		"test",
		"examples",
		"tsup.config.ts",
		"vitest.config.ts"
	]
}
