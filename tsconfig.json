{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"types": ["node"],
		"paths": {
			"react-flow-app": ["./src/index.ts"],
			"react-flow-app/react": ["./src/react/index.tsx"],
			"react-flow-app/analytics": ["./src/analytics/index.ts"],
			"react-flow-app/testing": ["./src/testing/index.ts"]
		}
	},
	"include": ["src", "test", "examples", "tsup.config.ts", "vitest.config.ts"]
}
